files:
  "/opt/elasticbeanstalk/tasks/taillogs.d/flask-app.conf":
    mode: "000755"
    owner: root
    group: root
    content: |
      /var/log/app-logs/application.log
      /var/log/app-logs/error.log

  "/etc/logrotate.d/flask-app":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/app-logs/*.log {
        daily
        rotate 10
        missingok
        compress
        delaycompress
        notifempty
        copytruncate
      }

container_commands:
  01_create_log_dir:
    command: "mkdir -p /var/log/app-logs"
    ignoreErrors: true
  02_change_permissions:
    command: "chmod 777 /var/log/app-logs"
    ignoreErrors: true