packages:
  yum:
    gcc-c++: []
    python3-devel: []
    libffi-devel: []
    openssl-devel: []
    freetype-devel: []
    libjpeg-turbo-devel: []
    pkgconf: []
    pkgconf-pkg-config: []

commands:
  01_pip_upgrade:
    command: "source /var/app/venv/*/bin/activate && pip install --upgrade pip setuptools wheel"
    ignoreErrors: false
  02_install_reportlab:
    command: "source /var/app/venv/*/bin/activate && pip install reportlab==3.6.12 --no-cache-dir"
    ignoreErrors: false
  03_install_dependencies:
    command: "source /var/app/venv/*/bin/activate && pip install -r requirements.txt --no-cache-dir || echo 'Some dependencies failed, but core should be installed'"
    ignoreErrors: true