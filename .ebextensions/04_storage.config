# Create .ebextensions/04_storage.config
commands:
  01_create_upload_dirs:
    command: |
      mkdir -p /var/app/current/app/uploads/default_files
      mkdir -p /var/app/current/app/temp_uploads
      chmod -R 755 /var/app/current/app/uploads
      chmod -R 755 /var/app/current/app/temp_uploads
      chown -R wsgi:wsgi /var/app/current/app/uploads
      chown -R wsgi:wsgi /var/app/current/app/temp_uploads
    ignoreErrors: false